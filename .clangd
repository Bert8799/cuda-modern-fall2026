If:
  PathMatch: .*\.(cu|cuh)$
Diagnostics:
  Suppress:
    - ovl_no_oper
    - ovl_no_viable_function_in_init
    - no_member
    - typename_nested_not_found

CompileFlags:
  Compiler: clang++
  Add:
    - --cuda-path=/usr/local/cuda
    # CUDA's pipeline headers live in CCCL; NVCC response files are removed below.
    - -isystem
    - /usr/local/cuda/include/cccl
    - -std=c++17
    - --cuda-gpu-arch=sm_75
    # Let clangd finish parsing so CUDA-related diagnostic suppressions apply.
    - -ferror-limit=100
  Remove:
    - -forward-unknown-to-host-compiler
    - -ccbin=*
    - --options-file
    - --generate-code=*
    - -G
    - -arch=native
